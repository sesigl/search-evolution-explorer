{
  "name": "search-evolution-explorer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit",
    "check": "biome ci .",
    "fix": "biome check --write .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "dupes": "jscpd src",
    "test": "vitest run --coverage",
    "test:two-tower": "python3 -m unittest discover -s scripts -p test_two_tower.py",
    "mutation": "stryker run",
    "crap": "node tools/crap.ts",
    "check:corpus": "node tools/check-corpus-invariants.ts",
    "check:content": "node tools/check-content-completeness.ts",
    "check:levels": "node tools/check-level-budget.ts",
    "check:examples": "node tools/check-examples.ts",
    "evaluate": "node tools/evaluate-search.ts",
    "similarity": "node tools/similarity.ts",
    "verify:wave1": "run-p --continue-on-error --aggregate-output typecheck check arch knip dupes test test:two-tower check:corpus check:content check:levels check:examples",
    "verify:wave2": "run-p --continue-on-error --aggregate-output mutation crap",
    "verify": "run-s --continue-on-error verify:wave1 verify:wave2",
    "data:wands": "node scripts/import-wands.ts",
    "data:embeddings": "node scripts/build-embeddings.ts",
    "data:clicks": "node scripts/simulate-clicks.ts",
    "data:bias-models": "node scripts/train-bias-models.ts",
    "data:train": "node scripts/train-ranker.ts",
    "data:cross-encoder": "node scripts/build-cross-encoder.ts",
    "data:precompute": "node scripts/precompute-results.ts",
    "data:two-tower": "node scripts/prepare-two-tower.ts && python3 scripts/train-two-tower.py && node scripts/calibrate-two-tower.ts",
    "data:all": "run-s data:wands data:embeddings data:clicks data:train data:cross-encoder data:two-tower"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/solid-js": "^7.0.2",
    "@astrojs/vercel": "11.0.13",
    "@huggingface/transformers": "4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.2",
    "solid-js": "^1.9.15",
    "stemmer": "2.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.3.1",
    "@vitest/coverage-istanbul": "4.1.10",
    "dependency-cruiser": "18.2.0",
    "jscpd": "5.2.0",
    "knip": "6.35.0",
    "npm-run-all2": "9.0.3",
    "ts-morph": "28.0.0",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  }
}
