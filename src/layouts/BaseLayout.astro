---
import "../styles/global.css";

interface Props {
  title: string;
  /** Optional monospace trail shown at the right of the top bar, for example the shareable path. */
  trail?: string;
  /** Set when the page mounts a guided tour; shows the button that restarts it. */
  hasTour?: boolean;
}

const { title, trail, hasTour = false } = Astro.props;
const path = Astro.url.pathname;

const nav = [
  { href: "/", label: "Contents", active: path === "/", id: undefined },
  { href: "/search", label: "Search", active: path.startsWith("/search"), id: undefined },
  { href: "/compare", label: "Compare", active: path.startsWith("/compare"), id: undefined },
  {
    href: "/level/level-1-recency",
    label: "Code",
    active: path.startsWith("/level/"),
    id: "nav-code",
  },
  { href: "/scorecard", label: "Scorecard", active: path.startsWith("/scorecard"), id: undefined },
  { href: "/bias", label: "Position bias", active: path.startsWith("/bias"), id: undefined },
  { href: "/beyond", label: "Beyond", active: path.startsWith("/beyond"), id: undefined },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="m-0 min-h-screen bg-paper text-ink">
    <header
      class="flex min-h-14 flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-rule bg-paper px-4 py-2 sm:px-7"
    >
      <a href="/" class="flex items-center gap-3 text-ink no-underline hover:text-ink">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 20h16"></path>
          <path d="M6 16h12"></path>
          <path d="M8 12h8"></path>
          <path d="M10 8h4"></path>
          <path d="M12 4v0"></path>
        </svg>
        <span class="whitespace-nowrap font-serif text-[19px] font-semibold tracking-[-0.01em]"
          >Search Evolution Explorer</span
        >
      </a>
      <nav class="flex max-w-full flex-wrap gap-0.5 text-[13.5px]" aria-label="Main">
        {
          nav.map((item) => (
            <a
              href={item.href}
              id={item.id}
              aria-current={item.active ? "page" : undefined}
              class:list={[
                "rounded-md px-2.5 py-1.5 font-medium no-underline hover:bg-paper-2 hover:text-ink",
                item.active ? "bg-paper-2 text-ink" : "text-ink-2",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="flex min-w-0 items-center gap-3 text-[12.5px] text-ink-3">
        {
          hasTour ? (
            <button
              type="button"
              id="tour-start"
              class="btn-ghost h-8 px-2.5 text-xs"
              title="Show me around this page"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M12 17v-5" />
                <path d="M12 8h.01" />
              </svg>
              Tour
            </button>
          ) : null
        }
        {
          trail !== undefined ? (
            <>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5" />
                <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5" />
              </svg>
              <span class="hidden truncate font-mono lg:inline" id="trail">{trail}</span>
            </>
          ) : null
        }
        <a
          href="https://github.com/sesigl/search-evolution-explorer"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-ink-2 no-underline hover:bg-paper-2 hover:text-ink"
          aria-label="Source code on GitHub (opens in a new tab)"
          title="Source code on GitHub"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
        </a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <script>
      // Glossary popovers open to the left when they would leave the viewport on the right.
      const WIDTH = 300;
      const MOBILE = 640;
      function place(event: Event) {
        const target = event.target;
        if (!(target instanceof Element)) {
          return;
        }
        const term = target.closest(".term");
        const tip = term?.querySelector<HTMLElement>("[role='tooltip']");
        if (!(term && tip)) {
          return;
        }
        if (window.innerWidth <= MOBILE) {
          // The small-screen rule pins the popover to the bottom; leave its position alone.
          tip.style.left = "";
          tip.style.right = "";
          return;
        }
        const rect = term.getBoundingClientRect();
        const overflows = rect.left + WIDTH > window.innerWidth - 16;
        tip.style.left = overflows ? "auto" : "0";
        tip.style.right = overflows ? "0" : "auto";
      }
      document.addEventListener("pointerover", place);
      document.addEventListener("focusin", place);
      document.addEventListener("focus", place, true);
      // The Tour button in the top bar restarts the page's guided tour.
      document.getElementById("tour-start")?.addEventListener("click", () => {
        document.dispatchEvent(new CustomEvent("see:tour:start"));
      });
    </script>
  </body>
</html>
