---
import { handleListTeachingQueries } from "../actions/grade-query.ts";
import { handleSearchWorkbench, parseWorkbenchRequest } from "../actions/search-workbench.ts";
import { SEARCH_TOUR } from "../content/tours.ts";
import SearchWorkbench from "../islands/search/SearchWorkbench.tsx";
import Tour from "../islands/tour/Tour.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";

// Query parameters belong to the browser, not to a server-rendered page.
const request = parseWorkbenchRequest(new URLSearchParams());
const [{ levels, state }, teachingQueries] = await Promise.all([
  handleSearchWorkbench(request),
  handleListTeachingQueries(),
]);
// Empty chapter views contain no search results. Build them once instead of calling a live API
// merely to open a chapter or the introduction.
const previews = Object.fromEntries(await Promise.all(levels.map(async (level) => {
  const preview = await handleSearchWorkbench({ ...request, levelId: level.id });
  return [level.id, preview.state];
})));
const trail = `/search?q=${encodeURIComponent(state.query)}&level=${encodeURIComponent(state.levelId)}`;
// The tour offers itself where the search layout is shown. It auto-starts on a first
// visit only over a blank workbench: arriving with a query means "show my results",
// and a centred welcome card must not cover the results a link promised.
const tourable = state.mode === "search";
---

<BaseLayout title="Search — Search Evolution Explorer" trail={trail} hasTour={tourable}>
  <SearchWorkbench
    client:load
    levels={levels}
    initial={state}
    previews={previews}
    teachingQueries={teachingQueries}
    gradeLevelId={null}
  />
  {
    tourable ? (
      <Tour
        client:load
        tour={SEARCH_TOUR}
        autoStart={false}
        startOnFirstVisit={true}
      />
    ) : null
  }
</BaseLayout>
