---
import { handleCompareLevels } from "../actions/compare-levels.ts";
import { handleGetLevels } from "../actions/get-levels.ts";
import LevelComparison from "../components/LevelComparison.astro";
import SearchStates from "../components/SearchStates.astro";
import { UseCaseError } from "../domain/search/errors.ts";
import type { CompareOutput } from "../domain/comparison/compare-levels.ts";
import BaseLayout from "../layouts/BaseLayout.astro";

const queryParam = Astro.url.searchParams.get("q") ?? "";
const leftLevelId = Astro.url.searchParams.get("left") ?? "level-1-recency";
const rightLevelId = Astro.url.searchParams.get("right") ?? "level-1-normalization";
const queryText = queryParam.trim();
const { levels } = await handleGetLevels();
const selectable = levels.filter((level) => level.implemented && level.ordinal > 0);

let comparison: CompareOutput | null = null;
let errorMessage: string | null = null;
if (queryText !== "") {
  try {
    comparison = await handleCompareLevels({
      queryText,
      leftLevelId,
      rightLevelId,
    });
  } catch (error) {
    if (error instanceof UseCaseError) {
      errorMessage = error.message;
    } else {
      throw error;
    }
  }
}

const trail = `/compare?q=${encodeURIComponent(queryText)}&left=${encodeURIComponent(leftLevelId)}&right=${encodeURIComponent(rightLevelId)}`;
---

<BaseLayout title="Compare — Search Evolution Explorer" trail={trail}>
  <div class="flex flex-col gap-[18px] px-7 pb-8 pt-6">
    <form
      method="get"
      action="/compare"
      class="grid items-center gap-2.5 lg:grid-cols-[minmax(0,1fr)_260px_40px_260px_auto]"
    >
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-3.5 top-[13px] text-ink-4"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          class="input pl-10 pr-3.5"
          type="search"
          name="q"
          value={queryParam}
          maxlength="200"
          placeholder="One query, two levels"
          aria-label="Query"
        />
      </div>
      {
        [
          { name: "left", value: leftLevelId, label: "Left level" },
          { name: "right", value: rightLevelId, label: "Right level" },
        ].map((select, index) => (
          <>
            {index === 1 ? (
              <div class="hidden justify-center text-ink-4 lg:flex" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 3 4 7l4 4" />
                  <path d="M4 7h16" />
                  <path d="m16 21 4-4-4-4" />
                  <path d="M20 17H4" />
                </svg>
              </div>
            ) : null}
            <div class="relative">
              <select class="select" name={select.name} aria-label={select.label}>
                {selectable.map((level) => (
                  <option value={level.id} selected={level.id === select.value}>
                    {level.ordinal} · {level.label}
                  </option>
                ))}
              </select>
              <svg
                class="pointer-events-none absolute right-3 top-4 text-ink-3"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </div>
          </>
        ))
      }
      <button type="submit" class="btn">Compare</button>
    </form>

    {
      queryText === "" ? (
        <SearchStates
          kind="empty"
          message="Enter a query and pick two levels. Both rankings appear side by side with every entered, exited, and moved listing marked, plus the signal that caused each change."
        />
      ) : null
    }
    {errorMessage !== null ? <SearchStates kind="unavailable" message={errorMessage} /> : null}
    {comparison !== null ? <LevelComparison comparison={comparison} now={new Date()} /> : null}
  </div>
</BaseLayout>
